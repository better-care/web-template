                                <archetype_id>
                                    <value>openEHR-EHR-CLUSTER.message_header_msh.v1</value>
                                </archetype_id>
                                <term_definitions code="at0000">
                                    <items id="text">Message header (MSH)</items>
                                    <items id="description">Message header MSH</items>
                                </term_definitions>
                                <term_definitions code="at0001">
                                    <items id="text">Sending application</items>
                                    <items id="description">This field uniquely identifies the sending application among all other applications within the network enterprise. </items>
                                    <items id="comment">This field is aligned with MSH.3 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0002">
                                    <items id="text">Sending facility</items>
                                    <items id="description">This field further describes the sending application, MSH-3-sending application.</items>
                                    <items id="comment">This field is aligned with MSH.4 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0003">
                                    <items id="text">Receiving application</items>
                                    <items id="description">This field uniquely identifies the receiving application among all other applications within the network enterprise.</items>
                                    <items id="comment">This field is aligned with MSH.5 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0004">
                                    <items id="text">Receiving facility</items>
                                    <items id="description">This field uniquely identifies the receiving application among all other applications within the network enterprise.</items>
                                    <items id="comment">This field is aligned with MSH.6 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0005">
                                    <items id="text">Date/time of message</items>
                                    <items id="description">This field contains the date/time that the sending system created the message.</items>
                                    <items id="comment">This field is aligned with MSH.7.1 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0006">
                                    <items id="text">Message type</items>
                                    <items id="description">This DV_CLUSTER contains the message type, trigger event, and the message structure ID for the message</items>
                                    <items id="comment">This DV_CLUSTER is aligned with MSH.9 segment in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0007">
                                    <items id="text">Message type</items>
                                    <items id="description"></items>
                                    <items id="comment">This field is aligned with MSH.9.1 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0008">
                                    <items id="text">Trigger event</items>
                                    <items id="description"></items>
                                    <items id="comment">This field is aligned with MSH.9.2 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0009">
                                    <items id="text">Message structure</items>
                                    <items id="description"></items>
                                    <items id="comment">This field is aligned with MSH.9.3 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0010">
                                    <items id="text">Message control ID</items>
                                    <items id="description">This field contains a number or other identifier that uniquely identifies the message.</items>
                                    <items id="comment">This field is aligned with MSH.10 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0011">
                                    <items id="text">Processing ID</items>
                                    <items id="description">This field is used to decide whether to process the message as defined in HL7 Application (level 7) Processing rules. The first component defines whether the message is part of a production, training, or debugging system (refer to HL7 Table 0103 - Processing ID for valid values). The second component defines whether the message is part of an archival process or an initial load (refer to HL7 Table 0207 - Processing modefor valid values). This allows different priorities to be given to different processing modes.</items>
                                    <items id="comment">This DV_CLUSTER is aligned with MSH.11 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0012">
                                    <items id="text">Processing ID</items>
                                    <items id="description">A value that defines whether the message is part of a production, training, or debugging system. Refer to HL7 Table 0103 - Processing ID for valid values.</items>
                                    <items id="comment">This field is aligned with MSH.11.1 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0013">
                                    <items id="text">Processing mode</items>
                                    <items id="description">A value that defines whether the message is part of an archival process or an initial load. Refer to HL7 Table 0207 - Processing mode for valid values.</items>
                                    <items id="comment">This field is aligned with MSH.11.2 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0014">
                                    <items id="text">Version ID</items>
                                    <items id="description">Used to identify the HL7 version. Refer to HL7 Table 0104 - Version ID for valid values.</items>
                                    <items id="comment">This field is aligned with MSH.12.1 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="at0015">
                                    <items id="text">Accept Acknowledgment Type</items>
                                    <items id="description"></items>
                                    <items id="comment">This field is aligned with MSH.15 field in HL7 v2.4.</items>
                                </term_definitions>
                                <term_definitions code="0103_processing_ID_HL7::D">
                                    <items id="text">Debugging</items>
                                </term_definitions>
                                <term_definitions code="0103_processing_ID_HL7::P">
                                    <items id="text">Production</items>
                                </term_definitions>
                                <term_definitions code="0103_processing_ID_HL7::T">
                                    <items id="text">Training</items>
                                </term_definitions>
                                <term_definitions code="0155_accept/application_acknowledgment_conditions_HL7::AL">
                                    <items id="text">Always</items>
                                </term_definitions>
                                <term_definitions code="0155_accept/application_acknowledgment_conditions_HL7::ER">
                                    <items id="text">Error/reject conditions only</items>
                                </term_definitions>
                                <term_definitions code="0155_accept/application_acknowledgment_conditions_HL7::NE">
                                    <items id="text">Never</items>
                                </term_definitions>
                                <term_definitions code="0155_accept/application_acknowledgment_conditions_HL7::SU">
                                    <items id="text">Successful completion only</items>
                                </term_definitions>
                            </children>
                            <cardinality>
                                <is_ordered>false</is_ordered>
                                <is_unique>false</is_unique>
                                <interval>
                                    <lower_included>true</lower_included>
                                    <upper_included>false</upper_included>
                                    <lower_unbounded>false</lower_unbounded>
                                    <upper_unbounded>true</upper_unbounded>
                                    <lower>0</lower>
                                </interval>
                            </cardinality>
                        </attributes>
                    </children>
                </attributes>
            </children>
        </attributes>
