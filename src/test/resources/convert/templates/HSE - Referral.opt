                </term_definitions>
                <term_definitions code="0004_patient_class_HL7::R">
                    <items id="text">Recurring Patient</items>
                </term_definitions>
                <term_definitions code="0004_patient_class_HL7::U">
                    <items id="text">Unknown</items>
                </term_definitions>
                <term_definitions code="0280_referral_priority_HL7::U">
                    <items id="text">Urgent</items>
                </term_definitions>
                <term_definitions code="0280_referral_priority_HL7::E">
