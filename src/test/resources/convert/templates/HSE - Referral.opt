                                        <term_definitions code="0085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL70085_observation_result_status_HL7::S">
