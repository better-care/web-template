                                        </term_definitions>
                                        <term_definitions code="0085_observation_result_status_HL7::P">
                                            <items id="text">Preliminary</items>
                                        </term_definitions>
                                        <term_definitions code="0085_observation_result_status_HL7::R">
                                            <items id="text">Results entered -- not verified</items>
                                        </term_definitions>
                                        <term_definitions code="0085_observation_result_status_HL7::S">
                                            <items id="text">Partial results</items>
                                        </term_definitions>
                                        <term_definitions code="0085_observation_result_status_HL7::U">
                                            <items id="text">Results status change to final without retransmitting results already sent as ‘preliminary.’</items>
                                        </term_definitions>
                                        <term_definitions code="0085_observation_result_status_HL7::W">
                                            <items id="text">Post original as wrong, e.g., transmitted for wrong patient</items>
                                        </term_definitions>
                                        <term_definitions code="0085_observation_result_status_HL7::X">
                                            <items id="text">Results cannot be obtained for this observation</items>
                                        </term_definitions>
                                    </children>
