                        <term_definitions code="at0003">
                            <items id="text">Interpreter required</items>
                            <items id="description">Is translation required?</items>
                            <items id="comment">For example, an English speaker in Quebec will not require an English interpreter but may require one if the consultation is being conducted in French.</items>
                        </term_definitions>
                        <term_definitions code="at0004">
