                        <term_definitions code="0123_result_status_HL7::A">
                            <items id="text">Some, but not all, results available</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::C">
                            <items id="text">Correction to results</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::F">
                            <items id="text">Final results</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::I">
                            <items id="text">No results available, specimen received, procedure incomplete</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::O">
                            <items id="text">Order received, specimen not yet received</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::P">
                            <items id="text">Preliminary</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::R">
                            <items id="text">Result stored</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::S">
                            <items id="text">No results available, procedure scheduled, but not done</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::X">
                            <items id="text">No results available, order cancelled</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::Y">
                            <items id="text">No order on record for this test</items>
                        </term_definitions>
                        <term_definitions code="0123_result_status_HL7::Z">
                            <items id="text">No record of this patient</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::C">
                            <items id="text">Record coming over is a correction and thus replaces a final result</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::D">
                            <items id="text">Deletes the OBX record</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::F">
                            <items id="text">Final</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::I">
                            <items id="text">Specimen in lab; results pending</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::N">
                            <items id="text">Not asked</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::O">
                            <items id="text">Order detail description only (no result)</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::P">
                            <items id="text">Preliminary</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::R">
                            <items id="text">Results entered -- not verified</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::S">
                            <items id="text">Partial results</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::U">
                            <items id="text">Results status change to final without retransmitting results already sent as ‘preliminary.’</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::W">
                            <items id="text">Post original as wrong, e.g., transmitted for wrong patient</items>
                        </term_definitions>
                        <term_definitions code="0085_observation_result_status_HL7::X">
                            <items id="text">Results cannot be obtained for this observation</items>
                        </term_definitions>
