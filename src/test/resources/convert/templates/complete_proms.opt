            </items>
            <items code="at0219">
                <items id="text">Pain in the mouth score</items>
                <items id="description">Score for the multi-item symptom scale 'Pain in the mouth' (PA), derived from item(s) 31, 32, 33, 34 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0220">
                <items id="text">Swallowing score</items>
                <items id="description">Score for the multi-item symptom scale 'Swallowing' (SW), derived from item(s) 35, 36, 37, 38 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0221">
                <items id="text">Problems with teeth score</items>
                <items id="description">Score for the multi-item symptom scale 'Problems with teeth' (TE), derived from item(s) 39, 40, 73 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0222">
                <items id="text">Problems opening mouth score</items>
                <items id="description">Score for the single-item symptom scale 'Problems opening mouth' (OM), derived from item(s) 41 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0223">
                <items id="text">Dry mouth and sticky saliva score</items>
                <items id="description">Score for the multi-item symptom scale 'Dry mouth and sticky saliva' (DR), derived from item(s) 42, 43 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0224">
                <items id="text">Problems with senses score</items>
                <items id="description">Score for the multi-item symptom scale 'Problems with senses' (SE), derived from item(s) 44, 45 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0225">
                <items id="text">Coughing score</items>
                <items id="description">Score for the single-item symptom scale 'Coughing' (CO), derived from item(s) 46 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0226">
                <items id="text">Speech score</items>
                <items id="description">Score for the multi-item symptom scale 'Speech' (SP), derived from item(s) 47, 55, 56, 57, 58 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0227">
                <items id="text">Body image score</items>
                <items id="description">Score for the multi-item symptom scale 'Body image' (BI), derived from item(s) 48, 49, 50 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0228">
                <items id="text">Social eating score</items>
                <items id="description">Score for the multi-item symptom scale 'Social eating' (SO), derived from item(s) 51, 52, 53, 54 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0229">
                <items id="text">Social contact score</items>
                <items id="description">Score for the single-item symptom scale 'Social contact' (SC), derived from item(s) 59 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0230">
                <items id="text">Sexuality score</items>
                <items id="description">Score for the multi-item symptom scale 'Sexuality' (SX), derived from item(s) 60, 61 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0231">
                <items id="text">Problems with shoulder score</items>
                <items id="description">Score for the multi-item symptom scale 'Problems with shoulder' (SH), derived from item(s) 62, 63 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0232">
                <items id="text">Swelling in the neck score</items>
                <items id="description">Score for the single-item symptom scale 'Swelling in the neck' (SN), derived from item(s) 64 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0233">
                <items id="text">Skin problems score</items>
                <items id="description">Score for the multi-item symptom scale 'Skin problems' (SK), derived from item(s) 65, 66, 67 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0234">
                <items id="text">Weight loss score</items>
                <items id="description">Score for the single-item symptom scale 'Weight loss' (WL), derived from item(s) 68 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0235">
                <items id="text">Fear of progression score</items>
                <items id="description">Score for the multi-item symptom scale 'Fear of progression' (FP), derived from item(s) 69, 70 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0236">
                <items id="text">Problems with wound healing score</items>
                <items id="description">Score for the single-item symptom scale 'Problems with wound healing' (WO), derived from item(s) 71 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0237">
                <items id="text">Neurological problems score</items>
                <items id="description">Score for the single-item symptom scale 'Neurological problems' (NE), derived from item(s) 72 by the linear transformation described in the EORTC QLQ-HN43 Scoring Manual. Range 0 to 100.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.act_questionnaire.v1">
        <term_definitions language="en">
            <items code="at0000">
                <items id="text">Asthma Control Test (ACT)</items>
                <items id="description">A patient-reported outcome measure used to record the level of asthma control experienced by a patient over the preceding 4 weeks, using the validated Asthma Control Test (ACT).</items>
            </items>
            <items code="at0001">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Last four weeks</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0006">
                <items id="text">1. During the last 4 weeks, how much of the time has your asthma kept you from getting as much done at work, school or home?</items>
                <items id="description"></items>
            </items>
            <items code="at0012">
                <items id="text">All of the time</items>
                <items id="description"></items>
            </items>
            <items code="at0013">
                <items id="text">Most of the time</items>
                <items id="description"></items>
            </items>
            <items code="at0014">
                <items id="text">Some of the time</items>
                <items id="description"></items>
            </items>
            <items code="at0015">
                <items id="text">A little of the time</items>
                <items id="description"></items>
            </items>
            <items code="at0016">
                <items id="text">None of the time</items>
                <items id="description"></items>
            </items>
            <items code="at0017">
                <items id="text">2. During the last 4 weeks, how often have you had shortness of breath?</items>
                <items id="description"></items>
            </items>
            <items code="at0018">
                <items id="text">More than once per day</items>
                <items id="description"></items>
            </items>
            <items code="at0019">
                <items id="text">Once per day</items>
                <items id="description"></items>
            </items>
            <items code="at0020">
                <items id="text">3 to 6 times per week</items>
                <items id="description"></items>
            </items>
            <items code="at0021">
                <items id="text">Once or twice per week</items>
                <items id="description"></items>
            </items>
            <items code="at0022">
                <items id="text">Not at all</items>
                <items id="description"></items>
            </items>
            <items code="at0023">
                <items id="text">3. During the last 4 weeks, how often have your asthma symptoms (wheezing, coughing, shortness of breath, chest tightness or pain) woken you up at night or earlier than usual in the morning?</items>
                <items id="description"></items>
            </items>
            <items code="at0024">
                <items id="text">4 or more nights per week</items>
                <items id="description"></items>
            </items>
            <items code="at0025">
                <items id="text">2 to 3 nights per week</items>
                <items id="description"></items>
            </items>
            <items code="at0026">
                <items id="text">Once per week</items>
                <items id="description"></items>
            </items>
            <items code="at0027">
                <items id="text">Once or Twice</items>
                <items id="description"></items>
            </items>
            <items code="at0028">
                <items id="text">Not at all</items>
                <items id="description"></items>
            </items>
            <items code="at0029">
                <items id="text">4. During the last 4 weeks, how often have you used your rescue inhaler or nebuliser medication (such as Salbutamol)?</items>
                <items id="description"></items>
            </items>
            <items code="at0030">
                <items id="text">3 or more times per day</items>
                <items id="description"></items>
            </items>
            <items code="at0031">
                <items id="text">Once or twice per day</items>
                <items id="description"></items>
            </items>
            <items code="at0032">
                <items id="text">2 or 3 times per week</items>
                <items id="description"></items>
            </items>
            <items code="at0033">
                <items id="text">Once a week or less</items>
                <items id="description"></items>
            </items>
            <items code="at0034">
                <items id="text">Not at all</items>
                <items id="description"></items>
            </items>
            <items code="at0035">
                <items id="text">5. How would you rate your asthma control during the last 4 weeks?</items>
                <items id="description"></items>
            </items>
            <items code="at0036">
                <items id="text">Not Controlled at all</items>
                <items id="description"></items>
            </items>
            <items code="at0037">
                <items id="text">Poorly Controlled</items>
                <items id="description"></items>
            </items>
            <items code="at0038">
                <items id="text">Somewhat Controlled</items>
                <items id="description"></items>
            </items>
            <items code="at0039">
                <items id="text">Well Controlled</items>
                <items id="description"></items>
            </items>
            <items code="at0040">
                <items id="text">Completely Controlled</items>
                <items id="description"></items>
            </items>
            <items code="at0041">
                <items id="text">Score</items>
                <items id="description"></items>
            </items>
            <items code="at0048">
                <items id="text">Item tree</items>
                <items id="description">@ internal @</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.vas_crs.v1">
        <term_definitions language="en">
            <items code="at0001">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Any point in time event</items>
                <items id="description">Default, unspecified point in time event which may be explicitly defined in a template or at run-time.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Blocked nose</items>
                <items id="description">Severity of blocked nose over the past 2 weeks, marked on a 0-10 cm visual analogue scale; the scale ends are labelled 'min' and 'max' on the form.</items>
            </items>
            <items code="at0005">
                <items id="text">Runny nose</items>
                <items id="description">Severity of runny nose over the past 2 weeks, marked on a 0-10 cm visual analogue scale; the scale ends are labelled 'min' and 'max' on the form.</items>
            </items>
            <items code="at0006">
                <items id="text">Reduced sense of smell</items>
                <items id="description">Severity of reduced sense of smell over the past 2 weeks, marked on a 0-10 cm visual analogue scale; the scale ends are labelled 'min' and 'max' on the form.</items>
            </items>
            <items code="at0007">
                <items id="text">Facial pressure/pain</items>
                <items id="description">Severity of facial pressure/pain over the past 2 weeks, marked on a 0-10 cm visual analogue scale; the scale ends are labelled 'min' and 'max' on the form.</items>
            </items>
            <items code="at0008">
                <items id="text">How would you rate the control of your disease over the past 4 weeks?</items>
                <items id="description"></items>
            </items>
            <items code="at0000">
                <items id="text">Visual analogue scales for chronic rhinosinusitis (VAS-CRS)</items>
                <items id="description">A patient-reported outcome measure (PROM) used to record four cardinal symptoms of chronic rhinosinusitis on 0–10 cm visual analogue scales over the past 2 weeks, and patient-rated disease control over the past 4 weeks.</items>
            </items>
        </term_definitions>
    </component_ontologies>
</template>