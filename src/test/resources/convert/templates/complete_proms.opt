            <items code="at0183">
                <items id="text">Global health status / QoL score</items>
                <items id="description">Score for the global health status scale 'Global health status / QoL' (QL), derived from item(s) 29, 30 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0169">
                <items id="text">Physical functioning score</items>
                <items id="description">Score for the functional scale 'Physical functioning' (PF), derived from item(s) 1 to 5 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0170">
                <items id="text">Role functioning score</items>
                <items id="description">Score for the functional scale 'Role functioning' (RF), derived from item(s) 6, 7 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0171">
                <items id="text">Emotional functioning score</items>
                <items id="description">Score for the functional scale 'Emotional functioning' (EF), derived from item(s) 21 to 24 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0172">
                <items id="text">Cognitive functioning score</items>
                <items id="description">Score for the functional scale 'Cognitive functioning' (CF), derived from item(s) 20, 25 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0173">
                <items id="text">Social functioning score</items>
                <items id="description">Score for the functional scale 'Social functioning' (SF), derived from item(s) 26, 27 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0174">
                <items id="text">Fatigue score</items>
                <items id="description">Score for the symptom scale 'Fatigue' (FA), derived from item(s) 10, 12, 18 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0175">
                <items id="text">Nausea and vomiting score</items>
                <items id="description">Score for the symptom scale 'Nausea and vomiting' (NV), derived from item(s) 14, 15 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0176">
                <items id="text">Pain score</items>
                <items id="description">Score for the symptom scale 'Pain' (PA), derived from item(s) 9, 19 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0177">
                <items id="text">Dyspnoea score</items>
                <items id="description">Score for the symptom scale 'Dyspnoea' (DY), derived from item(s) 8 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0178">
                <items id="text">Insomnia score</items>
                <items id="description">Score for the symptom scale 'Insomnia' (SL), derived from item(s) 11 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0179">
                <items id="text">Appetite loss score</items>
                <items id="description">Score for the symptom scale 'Appetite loss' (AP), derived from item(s) 13 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0180">
                <items id="text">Constipation score</items>
                <items id="description">Score for the symptom scale 'Constipation' (CO), derived from item(s) 16 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0181">
                <items id="text">Diarrhoea score</items>
                <items id="description">Score for the symptom scale 'Diarrhoea' (DI), derived from item(s) 17 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
            <items code="at0182">
                <items id="text">Financial difficulties score</items>
                <items id="description">Score for the symptom scale 'Financial difficulties' (FI), derived from item(s) 28 by the linear transformation described in the EORTC QLQ-C30 Scoring Manual. Range 0 to 100.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.eortc_qlq_hn43.v1">
        <term_definitions language="en">
            <items code="at0000">
                <items id="text">EORTC QLQ-HN43</items>
                <items id="description">The 43-item patient-reported outcome measure (PROM), the head and neck cancer module of the European Organisation for Research and Treatment of Cancer (EORTC) quality of life questionnaire, used as a supplement to the QLQ-C30; the updated successor of the QLQ-H&amp;N35.</items>
            </items>
