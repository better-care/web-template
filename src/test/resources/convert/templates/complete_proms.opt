                <items id="description">Default, unspecified point in time event which may be explicitly defined in a template or at run-time.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0011">
                <items id="text">1. I forget to take them</items>
                <items id="description"></items>
            </items>
            <items code="at0012">
                <items id="text">Always</items>
                <items id="description"></items>
            </items>
            <items code="at0013">
                <items id="text">Often</items>
                <items id="description"></items>
            </items>
            <items code="at0014">
                <items id="text">Sometimes</items>
                <items id="description"></items>
            </items>
            <items code="at0015">
                <items id="text">Rarely</items>
                <items id="description"></items>
            </items>
            <items code="at0016">
                <items id="text">Never</items>
                <items id="description"></items>
            </items>
            <items code="at0017">
                <items id="text">2. I alter the dose</items>
                <items id="description"></items>
            </items>
            <items code="at0018">
                <items id="text">Always</items>
                <items id="description"></items>
            </items>
            <items code="at0019">
                <items id="text">Often</items>
                <items id="description"></items>
            </items>
            <items code="at0020">
                <items id="text">Sometimes</items>
                <items id="description"></items>
            </items>
            <items code="at0021">
                <items id="text">Rarely</items>
                <items id="description"></items>
            </items>
            <items code="at0022">
                <items id="text">Never</items>
                <items id="description"></items>
            </items>
            <items code="at0035">
                <items id="text">3. I stop taking them for a while</items>
                <items id="description"></items>
            </items>
            <items code="at0036">
                <items id="text">Always</items>
                <items id="description"></items>
            </items>
            <items code="at0037">
                <items id="text">Often</items>
                <items id="description"></items>
            </items>
            <items code="at0038">
                <items id="text">Sometimes</items>
                <items id="description"></items>
            </items>
            <items code="at0039">
                <items id="text">Rarely</items>
                <items id="description"></items>
            </items>
            <items code="at0040">
                <items id="text">Never</items>
                <items id="description"></items>
            </items>
            <items code="at0023">
                <items id="text">4. I decide to miss out a dose</items>
                <items id="description"></items>
            </items>
            <items code="at0024">
                <items id="text">Always</items>
                <items id="description"></items>
            </items>
            <items code="at0025">
                <items id="text">Often</items>
                <items id="description"></items>
            </items>
            <items code="at0026">
                <items id="text">Sometimes</items>
                <items id="description"></items>
            </items>
            <items code="at0027">
                <items id="text">Rarely</items>
                <items id="description"></items>
            </items>
            <items code="at0028">
                <items id="text">Never</items>
                <items id="description"></items>
            </items>
            <items code="at0029">
                <items id="text">5. I take less than instructed</items>
                <items id="description"></items>
            </items>
            <items code="at0030">
                <items id="text">Always</items>
                <items id="description"></items>
            </items>
            <items code="at0031">
                <items id="text">Often</items>
                <items id="description"></items>
            </items>
            <items code="at0032">
                <items id="text">Sometimes</items>
                <items id="description"></items>
            </items>
            <items code="at0033">
                <items id="text">Rarely</items>
                <items id="description"></items>
            </items>
            <items code="at0034">
                <items id="text">Never</items>
                <items id="description"></items>
            </items>
            <items code="at0041">
                <items id="text">Total score</items>
                <items id="description">Sum of the scores for items 1 to 5. Range 5 to 25; higher scores indicate higher reported adherence.</items>
            </items>
        </term_definitions>
    </component_ontologies>
