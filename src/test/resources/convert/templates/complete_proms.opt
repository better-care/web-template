                <archetype_id>
                    <value>openEHR-EHR-OBSERVATION.eortc_qlq_c30.v0</value>
                </archetype_id>
                <term_definitions code="at0000">
                    <items id="text">EORTC QLQ-C30</items>
                    <items id="description">Ein PROM, der 30-Item zur Lebensqualität der European Organisation for Research and Treatment of Cancer (EORTC QLQ-C30), Version 3.0, zur Erfassung von Funktionsfähigkeit, Symptomen und globalem Gesundheitszustand/Lebensqualität bei Patientinnen und Patienten mit Krebserkrankungen.</items>
                </term_definitions>
                <term_definitions code="at0001">
                    <items id="text">History</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0002">
                    <items id="text">Beliebiges Ereignis zu einem Zeitpunkt</items>
                    <items id="description">Standardmäßiges, nicht näher bestimmtes Zeitpunkt-Ereignis, das in einem Template oder zur Laufzeit explizit definiert werden kann.</items>
                </term_definitions>
                <term_definitions code="at0003">
                    <items id="text">Tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0004">
                    <items id="text">1. Bereitet es Ihnen Schwierigkeiten, sich körperlich anzustrengen (z. B. eine schwere Einkaufstasche oder einen Koffer zu tragen)?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0005">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0006">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0007">
                    <items id="text">Ziemlich</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0008">
                    <items id="text">Sehr</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0009">
                    <items id="text">2. Bereitet es Ihnen Schwierigkeiten, einen längeren Spaziergang zu machen?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0038">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0039">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0040">
                    <items id="text">Ziemlich</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0041">
                    <items id="text">Sehr</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0010">
                    <items id="text">3. Bereitet es Ihnen Schwierigkeiten, eine kurze Strecke außer Haus zu gehen?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0042">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0043">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0044">
                    <items id="text">Ziemlich</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0045">
                    <items id="text">Sehr</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0011">
                    <items id="text">4. Müssen Sie tagsüber im Bett liegen oder in einem Sessel sitzen?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0046">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0047">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0048">
                    <items id="text">Ziemlich</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0049">
                    <items id="text">Sehr</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0012">
                    <items id="text">5. Brauchen Sie Hilfe beim Essen, Anziehen, Waschen oder Benutzen der Toilette?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0050">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0051">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0052">
                    <items id="text">Ziemlich</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0053">
                    <items id="text">Sehr</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0013">
                    <items id="text">6. Waren Sie bei Ihrer Arbeit oder bei anderen tagtäglichen Beschäftigungen eingeschränkt?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0054">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0055">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0056">
                    <items id="text">Ziemlich</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0057">
                    <items id="text">Sehr</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0014">
                    <items id="text">7. Waren Sie bei Ihren Hobbys oder anderen Freizeitbeschäftigungen eingeschränkt?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0058">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0059">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0060">
                    <items id="text">Ziemlich</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0061">
                    <items id="text">Sehr</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0015">
                    <items id="text">8. Waren Sie kurzatmig?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0062">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0063">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0064">
                    <items id="text">Ziemlich</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0065">
                    <items id="text">Sehr</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0016">
                    <items id="text">9. Hatten Sie Schmerzen?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0066">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0067">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0068">
                    <items id="text">Ziemlich</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0069">
                    <items id="text">Sehr</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0017">
                    <items id="text">10. Mussten Sie sich ausruhen?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0070">
                    <items id="text">Überhaupt nicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0071">
                    <items id="text">Wenig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0072">
