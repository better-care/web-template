                <term_definitions code="at0260">
                    <items id="text">Die 5 wichtigsten Beschwerden</items>
                    <items id="description">Ein von der Patientin oder dem Patienten als besonders wichtig markiertes Item (Nummer und/oder Wortlaut); maximal fünf Einträge.</items>
                </term_definitions>
                <term_definitions code="at0259">
                    <items id="text">Gesamtpunktzahl</items>
                    <items id="description">Summe der Punktwerte der Items 1 bis 22. Wertebereich 0 bis 110; höhere Werte weisen auf eine stärkere Beeinträchtigung hin.</items>
                </term_definitions>
                <term_definitions code="at0261">
                    <items id="text">1. Schnäuzen der Nase notwendig</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0262">
                    <items id="text">2. Verstopfte Nase / Behinderung der Nasenatmung</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0263">
                    <items id="text">3. Niesreiz</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0264">
                    <items id="text">4. Naselaufen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0265">
                    <items id="text">5. Husten</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0266">
                    <items id="text">6. Sekretfluss in den Rachen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0267">
                    <items id="text">7. Dickes, schleimiges Nasensekret</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0268">
                    <items id="text">8. Druckgefühl auf den Ohren</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0269">
                    <items id="text">9. Schwindelgefühl</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0270">
                    <items id="text">10. Ohrenschmerz</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0271">
                    <items id="text">11. Gesichtsschmerz, Druckgefühl im Gesicht</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0272">
                    <items id="text">12. Riechminderung/ Geschmacksminderung</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0273">
                    <items id="text">13. Probleme beim Einschlafen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0274">
                    <items id="text">14. Nächtliches Aufwachen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0275">
                    <items id="text">15. Mangel an gutem, nächtlichem Schlaf</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0276">
                    <items id="text">16. Müdigkeit beim Aufwachen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0277">
                    <items id="text">17. Erschöpfung</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0278">
                    <items id="text">18. Verminderte Leistungsfähigkeit</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0279">
                    <items id="text">19. Konzentrationsschwäche</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0280">
                    <items id="text">20. Frustrationen / Rastlosigkeit / Reizbarkeit</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0281">
                    <items id="text">21. Traurigkeit</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0282">
                    <items id="text">22. Nebenhöhlenbeschwerden sind mir peinlich</items>
                    <items id="description"></items>
                </term_definitions>
            </children>
