            <items code="at0196">
                <items id="text">A little</items>
                <items id="description"></items>
            </items>
            <items code="at0197">
                <items id="text">Quite a bit</items>
                <items id="description"></items>
            </items>
            <items code="at0198">
                <items id="text">Very much</items>
                <items id="description"></items>
            </items>
            <items code="at0042">
                <items id="text">69. Were you worried about the results of examinations and tests?</items>
                <items id="description"></items>
            </items>
            <items code="at0199">
                <items id="text">Not at all</items>
                <items id="description"></items>
            </items>
            <items code="at0200">
                <items id="text">A little</items>
