                <term_definitions code="at0183">
                    <items id="text">Globaler Gesundheitsstatus / Lebensqualität - Punktwert</items>
                    <items id="description">Punktwert der Skala des globalen Gesundheitsstatus 'Globaler Gesundheitsstatus / Lebensqualität' (QL), abgeleitet aus den Items 29, 30 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0169">
                    <items id="text">Körperliche Funktion - Punktwert</items>
                    <items id="description">Punktwert der Funktionsskala 'Körperliche Funktion' (PF), abgeleitet aus den Items 1 bis 5 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0170">
                    <items id="text">Rollenfunktion - Punktwert</items>
                    <items id="description">Punktwert der Funktionsskala 'Rollenfunktion' (RF), abgeleitet aus den Items 6, 7 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0171">
                    <items id="text">Emotionale Funktion - Punktwert</items>
                    <items id="description">Punktwert der Funktionsskala 'Emotionale Funktion' (EF), abgeleitet aus den Items 21 bis 24 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0172">
                    <items id="text">Kognitive Funktion - Punktwert</items>
                    <items id="description">Punktwert der Funktionsskala 'Kognitive Funktion' (CF), abgeleitet aus den Items 20, 25 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0173">
                    <items id="text">Soziale Funktion - Punktwert</items>
                    <items id="description">Punktwert der Funktionsskala 'Soziale Funktion' (SF), abgeleitet aus den Items 26, 27 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0174">
                    <items id="text">Müdigkeit - Punktwert</items>
                    <items id="description">Punktwert der Symptomskala 'Müdigkeit' (FA), abgeleitet aus den Items 10, 12, 18 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0175">
                    <items id="text">Übelkeit und Erbrechen - Punktwert</items>
                    <items id="description">Punktwert der Symptomskala 'Übelkeit und Erbrechen' (NV), abgeleitet aus den Items 14, 15 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0176">
                    <items id="text">Schmerzen - Punktwert</items>
                    <items id="description">Punktwert der Symptomskala 'Schmerzen' (PA), abgeleitet aus den Items 9, 19 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0177">
                    <items id="text">Dyspnoe - Punktwert</items>
                    <items id="description">Punktwert der Symptomskala 'Dyspnoe' (DY), abgeleitet aus Item 8 durch die im EORTC QLQ-C30 Scoring Manual beschriebene lineare Transformation. Wertebereich 0 bis 100.</items>
                </term_definitions>
                <term_definitions code="at0178">
