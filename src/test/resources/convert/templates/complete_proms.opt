                <term_definitions code="at0000">
                    <items id="text">EQ-5D-3L</items>
                    <items id="description">*The EQ-5D-3L is a non-disease-specific instrument for describing and valuing health states. (en)</items>
                    <items id="comment">Bitte wählen Sie für jede Überschrift die Aussage, die Ihre Gesundheit HEUTE am besten beschreibt.</items>
                </term_definitions>
                <term_definitions code="at0001">
                    <items id="text">History</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0002">
                    <items id="text">Any event</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0003">
                    <items id="text">Tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0012">
                    <items id="text">Item tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0015">
                    <items id="text">Mobilität</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0019">
                    <items id="text">Selbstfürsorge</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0024">
                    <items id="text">Aktivitäten</items>
                    <items id="description">(z.B. Arbeit, Studium, Hausarbeit, Familien- oder Freizeitaktivitäten)</items>
                </term_definitions>
                <term_definitions code="at0028">
                    <items id="text">Schmerzen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0032">
                    <items id="text">Angst / Niedergeschlagenheit</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0036">
                    <items id="text">Visuelle Analogskala (EQ VAS)</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0058">
                    <items id="text">Ich habe keine Probleme herumzugehen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0059">
                    <items id="text">Ich habe einige Probleme herumzugehen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0060">
                    <items id="text">Ich bin ans Bett gebunden</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0061">
                    <items id="text">Ich habe keine Probleme, für mich selbst zu sorgen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0062">
                    <items id="text">Ich habe einige Probleme, mich selbst zu waschen oder mich anzuziehen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0063">
                    <items id="text">Ich bin nicht in der Lage, mich selbst zu waschen oder anzuziehen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0064">
                    <items id="text">Ich habe keine Probleme, meinen alltäglichen Tätigkeiten nachzugehen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0065">
                    <items id="text">Ich habe einige Probleme, meinen alltäglichen Tätigkeiten nachzugehen</items>
