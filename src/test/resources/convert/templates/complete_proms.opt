                <archetype_id>
                    <value>openEHR-EHR-OBSERVATION.nccn_distress_thermometer_de.v0</value>
                </archetype_id>
                <term_definitions code="at0000">
                    <items id="text">NCCN Distress-Thermometer (Deutsche Version)</items>
                    <items id="description">Ein PROM, Screening-Instrument des National Comprehensive Cancer Network (NCCN) zur Erfassung psychosozialer Belastung bei onkologischen Patientinnen und Patienten, bestehend aus einem Thermometer (0–10) und einer Problemliste.</items>
                </term_definitions>
                <term_definitions code="at0001">
                    <items id="text">History</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0002">
                    <items id="text">die letzte Woche einschließlich heute</items>
                    <items id="description">Standardmäßiges, nicht näher bestimmtes Zeitpunkt-Ereignis, das in einem Template oder zur Laufzeit explizit definiert werden kann.</items>
                </term_definitions>
                <term_definitions code="at0003">
                    <items id="text">Tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0005">
                    <items id="text">Bitte kreisen Sie die Zahl ein (0-10), die am besten beschreibt, wie belastet Sie sich in der letzten Woche einschließlich heute gefühlt haben.</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0006">
                    <items id="text">0 - Gar nicht belastet</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0007">
                    <items id="text">1</items>
                    <items id="description"></items>
                </term_definitions>
