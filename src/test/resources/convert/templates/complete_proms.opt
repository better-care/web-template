                <archetype_id>
                    <value>openEHR-EHR-OBSERVATION.vas_crs.v1</value>
                </archetype_id>
                <term_definitions code="at0001">
                    <items id="text">History</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0002">
                    <items id="text">Beliebiges Ereignis zu einem Zeitpunkt</items>
                    <items id="description">Standardmäßiges, nicht näher bestimmtes Zeitpunkt-Ereignis, das in einem Template oder zur Laufzeit explizit definiert werden kann.</items>
                </term_definitions>
                <term_definitions code="at0003">
                    <items id="text">Tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0004">
                    <items id="text">Verstopfte Nase</items>
                    <items id="description">Schweregrad des Symptoms 'Verstopfte Nase' (NNH-Beschwerden, 'Beschwerden an der Nase/Nasennebenhöhlen in den letzten 2 Wochen') markiert auf einer visuellen Analogskala von 0-10 cm; die Skalenendpunkte sind auf dem Formular mit 'min' und 'max' beschriftet.</items>
                </term_definitions>
                <term_definitions code="at0005">
                    <items id="text">Nasenlaufen</items>
                    <items id="description">Schweregrad des Symptoms 'Nasenlaufen' (NNH-Beschwerden, 'Beschwerden an der Nase/Nasennebenhöhlen in den letzten 2 Wochen') markiert auf einer visuellen Analogskala von 0-10 cm; die Skalenendpunkte sind auf dem Formular mit 'min' und 'max' beschriftet.</items>
                </term_definitions>
                <term_definitions code="at0006">
                    <items id="text">Riechminderung</items>
                    <items id="description">Schweregrad des Symptoms 'Riechminderung' (NNH-Beschwerden, 'Beschwerden an der Nase/Nasennebenhöhlen in den letzten 2 Wochen') markiert auf einer visuellen Analogskala von 0-10 cm; die Skalenendpunkte sind auf dem Formular mit 'min' und 'max' beschriftet.</items>
                </term_definitions>
                <term_definitions code="at0007">
                    <items id="text">Gesichtsdruck/-schmerz</items>
                    <items id="description">Schweregrad des Symptoms 'Gesichtsdruck/-schmerz' (NNH-Beschwerden, 'Beschwerden an der Nase/Nasennebenhöhlen in den letzten 2 Wochen') markiert auf einer visuellen Analogskala von 0-10 cm; die Skalenendpunkte sind auf dem Formular mit 'min' und 'max' beschriftet.</items>
                </term_definitions>
                <term_definitions code="at0008">
                    <items id="text">Wie schätzen Sie die Kontrolle Ihrer Erkrankung in den letzten 4 Wochen ein?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0000">
                    <items id="text">Visuelle Analogskalen für chronische Rhinosinusitis (VAS-CRS)</items>
                    <items id="description">Ein PROM zur Erfassung der vier Kardinalsymptome der chronischen Rhinosinusitis auf 0–10 cm visuellen Analogskalen über die letzten 2 Wochen sowie der vom Patienten bewerteten Krankheitskontrolle über die letzten 4 Wochen.</items>
                </term_definitions>
            </children>
            <cardinality>
                <is_ordered>false</is_ordered>
                <is_unique>false</is_unique>
                <interval>
                    <lower_included>true</lower_included>
                    <upper_included>false</upper_included>
                    <lower_unbounded>false</lower_unbounded>
                    <upper_unbounded>true</upper_unbounded>
                    <lower>1</lower>
                </interval>
            </cardinality>
        </attributes>
        <archetype_id>
            <value>openEHR-EHR-COMPOSITION.self_reported_data.v1</value>
        </archetype_id>
        <template_id>
            <value>de.UDUS::openEHR-EHR-COMPOSITION.complete_proms.v1.0.0</value>
        </template_id>
        <term_definitions code="at0000">
            <items id="text">Alle Fragebögen</items>
            <items id="description">Generischer Container für Informationen, die von einer Person bereitgestellt werden.</items>
        </term_definitions>
        <term_definitions code="at0003">
            <items id="text">Item tree</items>
            <items id="description">@ internal @</items>
        </term_definitions>
        <term_definitions code="at0004">
            <items id="text">Erweiterung</items>
            <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
            <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen.</items>
        </term_definitions>
        <term_definitions code="at0005">
            <items id="text">Gerät</items>
            <items id="description">Um das Gerät zu erfassen, das zum Berichten von Daten verwendet wird.</items>
        </term_definitions>
        <term_definitions code="at0006">
            <items id="text">Informationsquelle</items>
            <items id="description">Über eine oder mehrere Arten von Quelle für die im Bericht enthaltenen Informationen.</items>
            <items id="comment">Dieses Datenelement kann verwendet werden, wenn sich die Informationsquelle vom Autor oder Verfasser unterscheidet. Zum Beispiel: "Elternteil" oder „Betreuer“.</items>
        </term_definitions>
    </definition>
    <ontology archetype_id="openEHR-EHR-COMPOSITION.self_reported_data.v1">
        <term_definitions language="en">
            <items code="at0000">
                <items id="text">de.UDUS::openEHR-EHR-COMPOSITION.complete_proms.v1.0.0</items>
                <items id="description">Generic container for information provided by an individual.</items>
            </items>
            <items code="at0003">
                <items id="text">Item tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Extension</items>
                <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
                <items id="comment">For example: local information requirements or additional metadata to align with FHIR.</items>
            </items>
            <items code="at0005">
                <items id="text">Device</items>
                <items id="description">To capture the device used to report data.</items>
            </items>
            <items code="at0006">
                <items id="text">Information Source</items>
                <items id="description">About one or more source types for the information contained in the report.</items>
                <items id="comment">This data element may be used when the Information source is different to the author or composer. For example: 'parent'; or 'carer'.</items>
            </items>
        </term_definitions>
    </ontology>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.eq_5d_3l.v0">
