    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.mars_5.v0">
        <term_definitions language="en">
            <items code="at0000">
                <items id="text">Medication Adherence Report Scale - 5 (MARS-5)</items>
                <items id="description">A patient-reported outcome measure (PROM) with five items in which the patient indicates how often their medicines are taken differently from the prescribed dosing instructions.</items>
            </items>
            <items code="at0001">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
