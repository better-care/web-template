                <items id="description"></items>
            </items>
            <items code="at0202">
                <items id="text">Very much</items>
                <items id="description"></items>
            </items>
            <items code="at0043">
                <items id="text">70. Were you worried about your future state of health?</items>
                <items id="description"></items>
            </items>
            <items code="at0203">
                <items id="text">Not at all</items>
                <items id="description"></items>
