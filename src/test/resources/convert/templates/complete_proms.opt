    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.eortc_qlq_c30.v0">
        <term_definitions language="en">
            <items code="at0000">
                <items id="text">EORTC QLQ-C30</items>
                <items id="description">A patient-reported outcome measure (PROM), the 30-item quality of life questionnaire of the European Organisation for Research and Treatment of Cancer (EORTC QLQ-C30), version 3.0, used to assess functioning, symptoms and global health status/quality of life in patients with cancer.</items>
            </items>
            <items code="at0001">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Any point in time event</items>
                <items id="description">Default, unspecified point in time event which may be explicitly defined in a template or at run-time.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">1. Do you have any trouble doing strenuous activities, like carrying a heavy shopping bag or a suitcase?</items>
                <items id="description"></items>
