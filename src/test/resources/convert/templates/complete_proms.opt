                <term_definitions code="at0000">
                    <items id="text">EORTC QLQ-HN43</items>
                    <items id="description">Das 43 Items umfassende PROM, das Kopf-Hals-Tumor-Modul des Lebensqualitätsfragebogens der European Organisation for Research and Treatment of Cancer (EORTC), das ergänzend zum QLQ-C30 eingesetzt wird, die aktualisierte Nachfolgeversion des QLQ-H&amp;N35.</items>
                </term_definitions>
                <term_definitions code="at0001">
                    <items id="text">History</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0002">
                    <items id="text">Beliebiges Ereignis zu einem Zeitpunkt</items>
                    <items id="description">Standardmäßiges, nicht näher bestimmtes Zeitpunkt-Ereignis, das in einem Template oder zur Laufzeit explizit definiert werden kann.</items>
                </term_definitions>
                <term_definitions code="at0003">
