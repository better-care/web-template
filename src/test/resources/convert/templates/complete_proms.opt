                <archetype_id>
                    <value>openEHR-EHR-OBSERVATION.mars_5.v0</value>
                </archetype_id>
                <term_definitions code="at0000">
                    <items id="text">Medication Adherence Report Scale - D (MARS-D)</items>
                    <items id="description">Ein PROM mit fünf Items, mit dem der Patient angibt, wie oft seine Arzneimittel abweichend von den verordneten Dosierungsanweisungen eingenommen werden.</items>
                </term_definitions>
                <term_definitions code="at0001">
                    <items id="text">History</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0002">
                    <items id="text">Beliebiges Ereignis zu einem Zeitpunkt</items>
                    <items id="description">Standardmäßiges, nicht näher bestimmtes Zeitpunkt-Ereignis, das in einem Template oder zur Laufzeit explizit definiert werden kann.</items>
                </term_definitions>
                <term_definitions code="at0003">
                    <items id="text">Tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0011">
                    <items id="text">1. Ich vergesse sie einzunehmen</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0012">
                    <items id="text">immer</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0013">
                    <items id="text">oft</items>
                    <items id="description"></items>
                </term_definitions>
