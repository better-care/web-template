            </items>
            <items code="at0206">
                <items id="text">Very much</items>
                <items id="description"></items>
            </items>
            <items code="at0044">
                <items id="text">71. Did you have problems with wound healing?</items>
                <items id="description"></items>
            </items>
            <items code="at0207">
                <items id="text">Not at all</items>
                <items id="description"></items>
